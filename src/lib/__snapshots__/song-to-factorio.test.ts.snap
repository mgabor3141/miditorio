        "direction": 4,
        "entity_number": 184,
        "name": "constant-combinator",
        "player_description": "Instrument and note data (part 6/6)\\n\\nEach signal value represents one or two song events. Each signal has a corresponding signal in the other combinator whose value contains the timing information for those events.",
        "position": {
          "x": -5,
          "y": -9
        }
      },
      {
        "control_behavior": {
          "decider_conditions": {
            "conditions": [
              {
                "comparator": "=",
                "first_signal": {
                  "name": "signal-each",
                  "type": "virtual"
                },
                "first_signal_networks": {
                  "green": false,
                  "red": true
                },
                "second_signal": {
                  "name": "signal-green",
                  "type": "virtual"
                }
              }
            ],
            "outputs": [
              {
                "networks": {
                  "green": true,
                  "red": false
                },
                "signal": {
                  "name": "signal-each",
                  "type": "virtual"
                }
              }
            ]
          }
        },
        "direction": 4,
        "entity_number": 185,
        "name": "decider-combinator",
        "player_description": "Let each signal through on the [color=green]green wire[/color] where the value of that same signal on the [color=red]red wire[/color] is equal to the [virtual-signal=signal-green] (time) signal.\\n\\nThis makes [virtual-signal=signal-green] a reserved signal and must not be present in the memory.\\n\\nOutput is any number of signals, where each signal contains one or two events, bit packed. Each event is made up of an instrument address and a note value.",
        "position": {
          "x": -3,
          "y": -9.5
        }
      },
      {
        "control_behavior": {
          "decider_conditions": {
            "conditions": [
              {
                "comparator": ">",
                "first_signal": {
                  "name": "signal-green",
                  "type": "virtual"
                },
                "first_signal_networks": {
                  "green": true,
                  "red": false
                }
              }
            ],
            "outputs": [
              {
                "signal": {
                  "name": "signal-everything",
                  "type": "virtual"
                }
              }
            ]
          }
        },
        "direction": 4,
        "entity_number": 186,
        "name": "decider-combinator",
        "player_description": "Clock\\n\\n[virtual-signal=signal-green] is the time (number of ticks) since the start of the song.",
        "position": {
          "x": -3,
          "y": -8.5
        }
      }
